SECRET_KEY=generate-a-long-random-string
AUTH_MODE=dev              # dev | shared | oidc | easyauth
# AUTH_MODE=shared adds one team-wide password to the dev form. A stopgap for a
# hosted trial before SSO exists - it identifies the team, not the person. Must be
# at least 12 characters or every login is refused.
# SHARED_PASSWORD=<long random string>
# REQUIRE_KNOWN_USER=1 makes the /admin user list the gate: an address must already
# be listed to sign in, so removing someone revokes access. Left open until the
# first user exists, so a fresh deployment can never lock everyone out.
# REQUIRE_KNOWN_USER=1
# ADMIN_EMAILS=you@qcells.com   # always admin; a way back in if the role is lost

# ---- Backups ----
# A snapshot is taken on sign-in when the newest is older than AUTO_BACKUP_HOURS,
# keeping AUTO_BACKUP_KEEP of them beside the database. 0 disables.
# AUTO_BACKUP_HOURS=24
# AUTO_BACKUP_KEEP=14
# BACKUP_TOKEN lets a scheduler elsewhere pull a backup with no login:
#   /backup/<token>          database only
#   /backup/<token>?full=1   database AND uploaded documents, as .tar.gz
# Must be 24+ characters or the route stays 404. Treat it as a password: it
# returns the entire dataset.
# BACKUP_TOKEN=<long random string>
ALLOWED_DOMAIN=qcells.com
# For AUTH_MODE=oidc with Microsoft Entra ID:
# OIDC_CLIENT_ID=<app registration client id>
# OIDC_CLIENT_SECRET=<client secret>
# OIDC_METADATA_URL=https://login.microsoftonline.com/<TENANT_ID>/v2.0/.well-known/openid-configuration

# ---- Airtable backend (see README > Airtable) ----
# AVL_BACKEND stays "sqlite" until the data layer is cut over; the Airtable
# tooling below works regardless, so the base can be built and verified first.
AVL_BACKEND=sqlite
# Personal access token from https://airtable.com/create/tokens with scopes
# data.records:read, data.records:write, schema.bases:read, schema.bases:write
# AIRTABLE_PAT=pat...
# AIRTABLE_BASE_ID=appNG0pJhGLBeR5Jh          # "AVL Manager" base
# AIRTABLE_WORKSPACE_ID=wspkuLFMhzRtCuxgt     # only needed to create a new base
# AIRTABLE_RATE_LIMIT=4                       # req/s; Airtable hard-caps at 5
